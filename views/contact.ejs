<!DOCTYPE html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Kontaktujte Jaroslava Tesaře – tvorba webových stránek a aplikací v Prostějově, Olomouci a Přerově."
    />
    <title>itesar | Kontakt</title>
    <link rel="canonical" href="https://itesar.cz/contact" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://itesar.cz/contact" />
    <meta property="og:title" content="itesar | Kontakt" />
    <meta property="og:description" content="Kontaktujte Jaroslava Tesaře – tvorba webových stránek a aplikací v Prostějově, Olomouci a Přerově." />
    <meta property="og:image" content="https://itesar.cz/images/logo.svg" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="itesar | Kontakt" />
    <meta name="twitter:description" content="Kontaktujte Jaroslava Tesaře – tvorba webových stránek a aplikací v Prostějově, Olomouci a Přerově." />
    <meta name="twitter:image" content="https://itesar.cz/images/logo.svg" />
    <%- include('partials/links') %>
  </head>
  <body>
    <%- include('partials/cookie-banner') %>
    <main>
      <header class="header"><%- include('./partials/navbar') %></header>
      <section id="title"></section>
      <div class="title-z">
        <h1>rychlý <span class="highlight">KONTAKT</span></h1>
      </div>
      <div class="article">
        <h2>Napište mi nebo zavolejte</h2>
        <form action="/message" method="post">
          <label for="message" class="sr-only">Vzkaz</label>
          <textarea
            id="message"
            name="message"
            class="contact-input"
            placeholder="Vzkaz"
          ></textarea>
          <label for="name" class="sr-only">Jméno</label>
          <input
            type="text"
            id="name"
            name="name"
            class="contact-input"
            placeholder="Jméno"
          />
          <label for="email" class="sr-only">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            class="contact-input"
            placeholder="Email"
          />
          <label for="tel" class="sr-only">Telefon</label>
          <input
            type="tel"
            id="tel"
            name="tel"
            class="contact-input"
            placeholder="Telefon"
          />
          <br />
          <button class="my-btn"><b>Odeslat</b></button>
        </form>
        <br />
        <div class="content-article-text">
          <i>TEL.: </i><a href="tel:+420723250858" class="my-a">723 250 858</a
          ><br />
          <i>EMAIL: </i
          ><a href="mailto:info@itesar.cz" class="my-a">info@itesar.cz</a><br />
          <i>ADRESA:</i> Pod Kosířem 71, Prostějov 79601<br />
        </div>
      </div>
    </main>
    <%- include('partials/footer') %>
  </body>
</html>
