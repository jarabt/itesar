<!DOCTYPE html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Nabízím webové služby za tyto ceny." />
    <title>itesar.cz Jaroslav Tesař | Kontaktujte mě</title>
    <%- include('partials/links') %>
  </head>
  <body>
    <%- include('partials/cookie-banner') %>
    <main>
      <div class="header"><%- include('./partials/navbar') %></div>
      <section id="title"></section>
      <div class="title-z">
        <h1>kontaktní <span class="highlight">INFO</span></h1>
      </div>
      <div class="sub-page about-article">
        <div class="content-article">
          <div class="content-article-title">
            <div class="contact-form">
              <form action="/message" method="post">
                <div class="form-input">
                  <label for="name">jméno</label>
                  <input type="text" id="name" name="name" />
                </div>
                <div class="form-input">
                  <label for="email">email</label>
                  <input type="email" id="email" name="email" />
                </div>
                <div class="form-input">
                  <label for="tel">telefon</label>
                  <input type="tel" id="tel" name="tel" />
                </div>
                <div class="form-input">
                  <label for="message">vzkaz</label>
                  <textarea id="message" name="message"></textarea>
                </div>
                <button class="form-button"><b>Odeslat</b></button>
              </form>
            </div>
            <div class="content-article-title-text">
              <h2>Rychlý kontakt.</h2>
            </div>
          </div>
          <div class="content-article-text">
            <p>INTERNETOVÁ PREZENTACE</p>
            <p>1490,- Kč</p>
            <ul>
              <li>design</li>
              <li>vložení zákazníkových textů</li>
              <li>vložení zákazníkových fotek</li>
              <li>vložení zákazníkova loga (ve formátu .svg)</li>
              <li>1 stránka, s maximálně 5-ti sekcemi</li>
              <li>nastavení hostingu</li>
              <li>termín 2 týdny</li>
            </ul>
          </div>
        </div>
      </div>
    </main>
    <%- include('partials/footer') %>
  </body>
</html>
