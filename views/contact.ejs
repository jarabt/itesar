<!DOCTYPE html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Nabízím webové služby za tyto ceny." />
    <title>itesar.cz Jaroslav Tesař | Kontaktujte mě</title>
    <%- include('partials/links') %>
  </head>
  <body>
    <%- include('partials/cookie-banner') %>
    <main>
      <div class="header"><%- include('./partials/navbar') %></div>
      <section id="title"></section>
      <div class="title-z">
        <h1>rychlý <span class="highlight">KONTAKT</span></h1>
      </div>
      <div class="article">
        <form action="/message" method="post">
          <textarea
            id="message"
            name="message"
            class="contact-input"
            placeholder="Vzkaz"
          ></textarea>
          <input
            type="text"
            id="name"
            name="name"
            class="contact-input"
            placeholder="Jméno"
          />
          <input
            type="email"
            id="email"
            name="email"
            class="contact-input"
            placeholder="Email"
          />
          <input
            type="tel"
            id="tel"
            name="tel"
            class="contact-input"
            placeholder="Telefon"
          />
          <br />
          <button class="my-btn"><b>Odeslat</b></button>
        </form>
        <br />
        <div class="content-article-text">
          <i>TEL.:</i> 723 250 858<br />
          <i>EMAIL:</i> info@itesar.cz<br />
          <i>ADRESA:</i> Pod Kosířem 71, Prostějov 79601<br />
        </div>
      </div>
    </main>
    <%- include('partials/footer') %>
  </body>
</html>
