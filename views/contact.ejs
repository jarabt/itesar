<!DOCTYPE html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Máte zájem o tvorbu webových stránek, aplikací nebo online poradenství? Kontaktujte mě pomocí kontaktního formuláře."
    />
    <title>itesar.cz Jaroslav Tesař | Kontaktní formulář</title>
    <%- include('partials/links') %>
  </head>
  <body>
    <main>
      <div class="header"><%- include('./partials/navbar') %></div>
      <div class="sub-page">
        <div class="container-sub-page">
          <h2 class="sub-title">Kontakt</h2>
          <form action="/message" method="post">
            <div class="card contact-card">
              <div>
                <div class="contact-card-small-item">
                  <label for="name"><b>JMÉNO</b></label
                  ><br />
                  <input type="text" id="name" name="name" />
                </div>
                <div class="contact-card-small-item">
                  <label for="email"><b>EMAIL</b></label
                  ><br />
                  <input type="email" id="email" name="email" />
                </div>
                <div class="contact-card-small-item">
                  <label for="tel"><b>TELEFON</b></label
                  ><br />
                  <input type="tel" id="tel" name="tel" />
                </div>
              </div>
              <div>
                <label for="message"><b>VZKAZ</b></label
                ><br />
                <textarea id="message" name="message"></textarea>
              </div>
            </div>
            <button><b>Odeslat</b></button>
          </form>
          <br />
          <br />
          <dl>
            <dt>Telefon</dt>
            <dd>723 250 858</dd>
            <dt>Email</dt>
            <dd>jarabt@seznam.cz</dd>
            <dt>Adresa</dt>
            <dd>Pod Kosířem 71, Prostějov</dd>
          </dl>
        </div>
      </div>
    </main>
    <%- include('partials/footer') %>
  </body>
</html>
