<!DOCTYPE html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Nabízím webové služby za tyto ceny." />
    <title>itesar.cz Jaroslav Tesař | Kontaktujte mě</title>
    <%- include('partials/links') %>
  </head>
  <body>
    <%- include('partials/cookie-banner') %>
    <main>
      <div class="header"><%- include('./partials/navbar') %></div>
      <section id="title"></section>
      <div class="title-z">
        <h1>kontaktní <span class="highlight">INFO</span></h1>
      </div>
      <div class="article">
        <form action="/message" method="post">
          <textarea
            id="message"
            name="message"
            rows="5"
            cols="40"
            class="contact-input"
            placeholder="Vzkaz"
          ></textarea>
          <input
            type="text"
            id="name"
            name="name"
            class="contact-input"
            placeholder="Jméno"
          />
          <input
            type="email"
            id="email"
            name="email"
            class="contact-input"
            placeholder="Email"
          />
          <input
            type="tel"
            id="tel"
            name="tel"
            class="contact-input"
            placeholder="Telefon"
          />
          <br />
          <button class="my-btn"><b>Odeslat</b></button>
        </form>
        <div class="content-article-text">
          <p>INTERNETOVÁ PREZENTACE</p>
          <p>1490,- Kč</p>
          <ul>
            <li>design</li>
            <li>vložení zákazníkových textů</li>
            <li>vložení zákazníkových fotek</li>
            <li>vložení zákazníkova loga (ve formátu .svg)</li>
            <li>1 stránka, s maximálně 5-ti sekcemi</li>
            <li>nastavení hostingu</li>
            <li>termín 2 týdny</li>
          </ul>
        </div>
      </div>
    </main>
    <%- include('partials/footer') %>
  </body>
</html>
