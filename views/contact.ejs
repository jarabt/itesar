<!DOCTYPE html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Máte zájem o tvorbu webových stránek, aplikací nebo online poradenství? Kontaktujte mě pomocí kontaktního formuláře."
    />
    <!-- Google tag (gtag.js) -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-ENJSZC257Q"
    ></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-ENJSZC257Q");
    </script>
    <link rel="shortcut icon" href="./favicon.ico" sizes="any" />
    <title>itesar.cz Jaroslav Tesař | Kontaktní formulář</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Mansalva&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="./styles/styles.css" />
  </head>
  <body>
    <div class="header"><%- include('./partials/navbar') %></div>
    <div class="sub-page">
      <div class="container-sub-page">
        <h2 class="sub-title">Kontakt</h2>
        <form action="/message" method="post">
          <div class="card contact-card">
            <div>
              <div class="contact-card-small-item">
                <label for="name"><b>JMÉNO</b></label
                ><br />
                <input type="text" id="name" name="name" />
              </div>
              <div class="contact-card-small-item">
                <label for="email"><b>EMAIL</b></label
                ><br />
                <input type="email" id="email" name="email" />
              </div>
              <div class="contact-card-small-item">
                <label for="tel"><b>TELEFON</b></label
                ><br />
                <input type="tel" id="tel" name="tel" />
              </div>
            </div>
            <div>
              <label for="message"><b>VZKAZ</b></label
              ><br />
              <textarea id="message" name="message"></textarea>
            </div>
          </div>
          <button><b>Odeslat</b></button>
        </form>
        <br />
        <br />
        <dl>
          <dt>Telefon</dt>
          <dd>723 250 858</dd>
          <dt>Email</dt>
          <dd>jarabt@seznam.cz</dd>
          <dt>Adresa</dt>
          <dd>Pod Kosířem 71, Prostějov</dd>
        </dl>
      </div>
    </div>
    <%- include('partials/footer') %>
  </body>
</html>
