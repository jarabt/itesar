<!DOCTYPE html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="<%= article.subheadline %>" />
    <title>itesar | <%= article.headline %></title>
    <%- include('partials/links') %>
  </head>
  <body>
    <%- include('partials/cookie-banner') %>
    <main>
      <div class="header"><%- include('./partials/navbar') %></div>
      <section id="title"></section>
      <div class="title-z">
        <h1><%= article.headline %></h1>
      </div>
      <div class="bellow-title-z">
        <div class="content-article">
          <img
            src="/article_images/<%= article.id %>.png"
            alt="<%= article.alt %>"
            class="content-article-title-image"
          />
          <div class="content-article-text">
            <p><b><%- article.subheadline %></b></p>
            <p><%- article.content %></p>
          </div>
        </div>
      </div>
    </main>
    <%- include('partials/footer') %>
  </body>
</html>
