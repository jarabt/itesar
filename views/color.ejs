<!DOCTYPE html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Převaděč kódů barev z RGB na HEX zdarma on-line"
    />
    <title>itesar.cz Jaroslav Tesař | RGB na HEX</title>
    <%- include('partials/links') %>
  </head>
  <body>
    <%- include('partials/cookie-banner') %>

    <main>
      <div class="header"><%- include('./partials/navbar') %></div>
      <!-- Title -->
      <section id="title"></section>
      <div class="title-z">
        <h1>Zadejte <span class="highlight">RGB kód</span></h1>
      </div>
      <div class="container-about">
        <div class="article">
          <textarea
            class="color-input"
            type="text"
            id="color-input"
            name="color-input"
            rows="3"
            cols="23"
          ></textarea
          ><br />
          <span class="rgb-result"></span>
          <button class="button-copy-rgb">
            <%- include('partials/copy-svg') %></button
          ><br />
          <span class="hex-result"></span>
          <button class="button-copy-hex">
            <%- include('partials/copy-svg') %></button
          ><br />
          <span class="hex-result2"></span>
          <button class="button-copy-hex2">
            <%- include('partials/copy-svg') %>
          </button>
          <br />
          <img
            class="brush-stroke"
            src="/images/brush-stroke4.svg"
            alt="Vzorek převáděné barvy."
          />
        </div>
      </div>
    </main>
    <%- include('partials/footer') %>
    <script src="/scripts/color.js"></script>
  </body>
</html>
