<!DOCTYPE html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Články o www pro všechny." />
    <title>itesar.cz Jaroslav Tesař | Články o webech</title>
    <%- include('partials/links') %>
  </head>
  <body>
    <%- include('partials/cookie-banner') %>
    <main>
      <div class="header"><%- include('./partials/navbar') %></div>
      <section id="title"></section>
      <div class="title-z">
        <h1>www <span class="highlight">ČLÁNKY</span></h1>
      </div>
      <div class="bellow-title-z">
        <div class="articles-list">
          <% articles.forEach(item => { %>
          <div class="articles-list-item">
            <img
              src="/article_images/<%= item.id %>.png"
              alt="<%= item.alt %>"
              class="articles-list-img"
            />
            <div class="articles-list-item-right">
              <div>
                <a href="/<%= item.url %>" class="my-a"><%= item.headline %></a>
                <p class="articles-list-item-subheadline">
                  <%= item.subheadline %>
                </p>
              </div>
              <p class="articles-list-item-date"><%= item.date %></p>
            </div>
          </div>
          <% }); %>
        </div>
      </div>
    </main>
    <%- include('partials/footer') %>
  </body>
</html>
