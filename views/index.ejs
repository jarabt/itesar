    <!-- About -->
    <div class="container-about">
      <div class="grid-container">
        <div class="left card text-card">
          <h2>SLUŽBY</h2>
          <ul>
            <li>tvorba: Internetové stránky</li>
            <li>poradím: Použití sociálních sítí</li>
            <li>poradím: Jak být na Google</li>
            <li>tvorba: Chytré stránky</li>
          </ul>
        </div>
        <div class="card text-card">
          <h2>JSEM JAROSLAV TESAŘ</h2>
          <div class="portrait-card">
            <img src="portrait.png" alt="foto Jaroslav Tesař" />
          </div>
        </div>
        <div class="right card text-card">
          <h2>CO UMÍ CHYTRÉ STRÁNKY</h2>
          <ul>
            <li>Uchovávat bezpečně vaše seznamy (např. zákazníků)</li>
            <li>Tyto seznamy jsou přístupné odkudkoliv (třeba z mobilu)</li>
            <li>Práce se seznamy - vyhledávání apod.</li>
            <li>Návštěvníci vám posílají odtud zprávy na email</li>
            <li>
              Přes svoje heslo můžete do stránky vkládat data, články apod.
            </li>
          </ul>
        </div>
        <div class="me card text-card">
          <h2>O MNĚ</h2>
          <ul>
            <li>přes 5 let v programátorských firmách</li>
            <li>vystudoval marketing a obchod</li>
            <li>kurz marketingu na internetu</li>
            <li>kurz tvorby chytrých internetových stránek</li>
          </ul>
          <ul class="contact">
            <li>tel.: 723250858</li>
            <li>email: jarabt@seznam.cz</li>
          </ul>
        </div>
      </div>
    </div>
    <!-- Pricing -->
    <br />
    <br />
    <section id="pricing">
      <div class="container-pricing">
        <div class="price-card">
          <h2>
            <span class="price-title">Základní balíček</span><br />1500,- Kč
          </h2>
          <p class="p-title">INTERNETOVÁ PREZENTACE</p>
          <ul>
            <li>design</li>
            <li>vložení zákazníkových textů</li>
            <li>vložení zákazníkových fotek</li>
            <li>vložení zákazníkova loga (ve formátu .svg)</li>
            <li>1 stránka, s maximálně 5-ti sekcemi</li>
            <li>nastavení hostingu</li>
            <li>termín 2 týdny</li>
          </ul>
        </div>
        <div class="price-card">
          <h2>
            <span class="price-title">Standardní balíček</span><br />6000,- Kč
          </h2>
